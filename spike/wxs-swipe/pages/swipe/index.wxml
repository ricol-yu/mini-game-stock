<wxs module="g" src="../../wxs/gesture.wxs"></wxs>

<view class="page">

  <view class="hud">
    <view class="row">
      <text class="nm">金钱</text>
      <view class="bar"><view class="bar-i s-cash" style="width:72%"></view></view>
      <text class="vl">18,000</text>
    </view>
    <view class="row">
      <text class="nm">心态</text>
      <view class="bar"><view class="bar-i s-mind" style="width:58%"></view></view>
      <text class="vl">58</text>
    </view>
    <view class="row">
      <text class="nm">风险</text>
      <view class="bar"><view class="bar-i s-risk" style="width:9%"></view></view>
      <text class="vl">9</text>
    </view>
    <view class="row">
      <text class="nm">社会</text>
      <view class="bar"><view class="bar-i s-soc" style="width:56%"></view></view>
      <text class="vl">56</text>
    </view>
  </view>

  <view class="stage">
    <view class="card card-under2"></view>
    <view class="card card-under"></view>

    <view class="card card-top"
          change:prop="{{g.observe}}"
          prop="{{round}}"
          bindtouchstart="{{g.touchstart}}"
          bindtouchmove="{{g.touchmove}}"
          bindtouchend="{{g.touchend}}"
          bindtouchcancel="{{g.touchend}}">

      <view class="stamp stamp-l">抽身</view>
      <view class="stamp stamp-r">投入</view>

      <view class="who">
        <view class="av">{{card.av}}</view>
        <text class="nm">{{card.who}}</text>
        <text class="tag">{{card.tag}}</text>
      </view>

      <view class="txt">{{card.txt}}</view>

      <view class="foot">
        <text class="l">← {{card.L}}</text>
        <text class="r">{{card.R}} →</text>
      </view>
    </view>
  </view>

  <view class="tips">左滑抽身 · 右滑投入 · 松手后数据才回传逻辑层</view>

  <view class="report">
    <view class="rep-row">
      <text class="rep-k">采样</text>
      <text class="rep-v">{{rep ? rep.events + ' 次 / ' + rep.duration + 'ms' : '—'}}</text>
    </view>
    <view class="rep-row">
      <text class="rep-k">帧间隔</text>
      <text class="rep-v">{{rep ? rep.avgGap + ' / ' + rep.maxGap + ' ms' : '—'}}</text>
    </view>
    <view class="rep-row">
      <text class="rep-k">估算 fps</text>
      <text class="rep-v">{{rep ? rep.fps : '—'}}</text>
    </view>
    <view class="rep-row">
      <text class="rep-k">WXS 单帧</text>
      <text class="rep-v">{{rep ? rep.costAvg + ' / ' + rep.costMax + ' ms' : '—'}}</text>
    </view>
    <view class="rep-row">
      <text class="rep-k">位移</text>
      <text class="rep-v">{{rep ? rep.dx + ' px ' + (rep.fired ? '已触发' : '回弹') : '—'}}</text>
    </view>
    <view class="verdict {{verdictLevel}}">{{verdict}}</view>
  </view>

  <view class="ops">
    <text class="op" bindtap="toggleRepeat">{{repeat ? '固定同一张' : '正常换卡'}}</text>
    <text class="op" bindtap="restart">重置</text>
    <text class="op">{{swipes}} 次</text>
  </view>

</view>
