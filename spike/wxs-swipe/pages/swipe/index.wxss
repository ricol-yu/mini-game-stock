page {
  background: #f2f3f5;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 4px 0 6px;
}

.hud {
  padding: 0 14px 2px;
  flex: 0 0 auto;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 5px;
}

.row .nm {
  font-size: 11px;
  color: #646a73;
  width: 28px;
  flex: 0 0 auto;
}

.row .vl {
  font-size: 11px;
  width: 62px;
  text-align: right;
  flex: 0 0 auto;
  color: #1f2329;
}

.bar {
  flex: 1;
  height: 8px;
  border-radius: 4px;
  background: #eef0f3;
  overflow: hidden;
  position: relative;
  margin: 0 8px;
}

.bar-i {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  border-radius: 4px;
}

.s-cash {
  background: linear-gradient(90deg, #ffc07a, #f79c1e);
}

.s-mind {
  background: linear-gradient(90deg, #9fc0ff, #1a6dff);
}

.s-risk {
  background: linear-gradient(90deg, #ffd666, #d4380d);
}

.s-soc {
  background: linear-gradient(90deg, #95de64, #237804);
}

.stage {
  flex: 1;
  position: relative;
  margin: 0 16px;
  min-height: 200px;
}

/* 原型用的是 inset:4px 0 8px，WXSS 部分基础库不认，这里拆开写 */
.card {
  position: absolute;
  top: 4px;
  right: 0;
  bottom: 8px;
  left: 0;
  background: #ffffff;
  border: 1px solid #e5e6eb;
  border-radius: 16px;
  box-shadow: 0 10px 26px rgba(31, 35, 41, 0.11);
  padding: 16px 17px 12px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  will-change: transform;
}

.card-under {
  transform: scale(0.955) translateY(9px);
  opacity: 0.55;
  box-shadow: 0 4px 12px rgba(31, 35, 41, 0.07);
}

.card-under2 {
  transform: scale(0.91) translateY(18px);
  opacity: 0.28;
}

.card-top {
  opacity: 1;
}

.stamp {
  position: absolute;
  top: 14px;
  padding: 5px 11px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.5px;
  border: 3px solid #999999;
  opacity: 0;
  background: rgba(255, 255, 255, 0.94);
  max-width: 200px;
}

.stamp-l {
  left: 13px;
  color: #0aa344;
  border-color: #0aa344;
  transform: rotate(-11deg);
}

.stamp-r {
  right: 13px;
  color: #e02020;
  border-color: #e02020;
  transform: rotate(11deg);
}

.who {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.who .av {
  width: 31px;
  height: 31px;
  border-radius: 50%;
  background: #f4f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  margin-right: 8px;
}

.who .nm {
  font-size: 12px;
  color: #646a73;
}

.who .tag {
  margin-left: auto;
  font-size: 10px;
  color: #8f959e;
  border: 1px solid #e5e6eb;
  border-radius: 4px;
  padding: 1px 5px;
}

.txt {
  font-size: 16px;
  line-height: 1.72;
  color: #1f2329;
  flex: 1;
  letter-spacing: 0.2px;
}

.foot {
  border-top: 1px dashed #e5e6eb;
  padding-top: 8px;
  font-size: 11px;
  display: flex;
  justify-content: space-between;
}

.foot .l {
  color: #0aa344;
}

.foot .r {
  color: #e02020;
}

.tips {
  padding: 6px 16px 2px;
  text-align: center;
  font-size: 10px;
  color: #8f959e;
  flex: 0 0 auto;
}

.report {
  margin: 6px 16px 0;
  padding: 8px 12px;
  background: #ffffff;
  border: 1px solid #e5e6eb;
  border-radius: 10px;
  flex: 0 0 auto;
}

.rep-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  line-height: 1.75;
}

.rep-k {
  color: #8f959e;
}

.rep-v {
  color: #1f2329;
}

.verdict {
  margin-top: 4px;
  font-size: 11px;
  line-height: 1.6;
  color: #646a73;
}

.verdict.ok {
  color: #0aa344;
}

.verdict.warn {
  color: #d4380d;
}

.ops {
  display: flex;
  justify-content: center;
  padding: 6px 16px 0;
  flex: 0 0 auto;
}

.op {
  font-size: 11px;
  color: #646a73;
  border: 1px solid #e5e6eb;
  background: #ffffff;
  border-radius: 12px;
  padding: 3px 10px;
  margin: 0 5px;
}
